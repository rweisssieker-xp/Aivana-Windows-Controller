 <Package Name="MAKRIVO" Manufacturer="Aivana GmbH" Version="$(var.PackageVersion)" UpgradeCode="F08E1353-12D6-4F98-BB6C-A047D2F1A1D6" Scope="perUser" InstallerVersion="500">
